{
  "name": "pharmacy-erp-monorepo",
  "version": "1.0.0",
  "description": "Pharmacy Operations ERP - Monorepo (Frontend + Backend)",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm --prefix backend start",
    "build": "npm --prefix backend install --include=dev && npm --prefix backend run build",
    "postinstall": "npm --prefix backend install --include=dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build"
  }
}
